# Copy to .env and adjust for your machine. Do not commit .env.

# Hugging Face model identifier (Diffusers-compatible text-to-image)
MODEL_ID=runwayml/stable-diffusion-v1-5
MODEL_REVISION=
MODEL_VARIANT=

# Device: auto | cuda | mps | cpu
DEVICE=auto

# Torch dtype: auto | float16 | bfloat16 | float32
TORCH_DTYPE=auto

# Where generated PNG + JSON metadata are written (relative or absolute)
OUTPUT_DIRECTORY=generated

# Conservative dimension caps (must remain divisible by 8)
MAX_WIDTH=1024
MAX_HEIGHT=1024

# Optional memory helpers for low-VRAM GPUs
ENABLE_CPU_OFFLOAD=false

# Set true to refuse downloading weights (offline / cached-only)
LOCAL_FILES_ONLY=false

# Optional: Hugging Face token if the model requires authentication
# HF_TOKEN=

# Logging
LOG_LEVEL=INFO
