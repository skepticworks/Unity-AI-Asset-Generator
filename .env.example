# Copy to .env and adjust for your machine. Do not commit .env.

# Hugging Face model identifier (Diffusers-compatible text-to-image)
MODEL_ID=runwayml/stable-diffusion-v1-5
MODEL_REVISION=
MODEL_VARIANT=
MODEL_FAMILY=sd15
MODEL_DISPLAY_NAME=Stable Diffusion 1.5

# Device: auto | cuda | mps | cpu
DEVICE=auto

# Torch dtype: auto | float16 | bfloat16 | float32
TORCH_DTYPE=auto

# Where generated PNG + JSON metadata are written (relative or absolute)
OUTPUT_DIRECTORY=generated

# Authoritative generation policy (drives validation + capability reporting)
MIN_WIDTH=8
MAX_WIDTH=1024
MIN_HEIGHT=8
MAX_HEIGHT=1024
WIDTH_MULTIPLE=8
HEIGHT_MULTIPLE=8
MIN_STEPS=1
MAX_STEPS=150
DEFAULT_STEPS=25
MIN_GUIDANCE_SCALE=0.0
MAX_GUIDANCE_SCALE=30.0
DEFAULT_GUIDANCE_SCALE=7.0
MIN_SEED=0
MAX_SEED=4294967295
MAX_PROMPT_LENGTH=2000
MAX_NEGATIVE_PROMPT_LENGTH=2000
MAX_OUTPUT_NAME_LENGTH=100
MAX_CONCURRENT_GENERATIONS=1
# Local job queue (JSON files under OUTPUT_DIRECTORY/jobs by default)
MAX_JOB_RETRIES=2
JOB_AUTO_RETRY=true
# JOB_DIRECTORY=
JOB_HISTORY_LIMIT=100

# Image-to-image (source is the init/latent image, not IP-Adapter reference conditioning)
MIN_DENOISING_STRENGTH=0.0
MAX_DENOISING_STRENGTH=1.0
DEFAULT_DENOISING_STRENGTH=0.75
MAX_SOURCE_IMAGE_BYTES=10485760
# Inpainting masks (white=regenerate, black=keep). Same size/format policy as source images.
MAX_MASK_IMAGE_BYTES=10485760

# Stable public scheduler identifier when selection is unsupported
# DEFAULT_SCHEDULER=pndm

# Optional memory helpers for low-VRAM GPUs
ENABLE_CPU_OFFLOAD=false
# When true (and CPU offload is off), only one GPU-resident model occupies VRAM at a time
# across txt2img, background removal (rembg), and seam inpaint. Post-processing weights are
# unloaded before txt2img; txt2img is unloaded before post-processing; post-processing is
# unloaded after each request. Prefer this when reload time is acceptable but shared VRAM is not.
EXCLUSIVE_MODEL_VRAM=true

# Set true to refuse downloading weights (offline / cached-only)
LOCAL_FILES_ONLY=false

# Optional: Hugging Face token if the model requires authentication
# HF_TOKEN=

# --- Sprite/icon transparency post-processing (not native diffusion alpha) ---
# Requires: pip install -e ".[background-removal]"
# When true but rembg is missing, capabilities report available=false with install guidance.
BACKGROUND_REMOVAL_ENABLED=true
BACKGROUND_REMOVAL_BACKEND=rembg
BACKGROUND_REMOVAL_MODEL=u2net
# When true, also persist the pre-processed RGB PNG as *.original.png
PRESERVE_ORIGINAL_IMAGE=true

# Alpha cleanup defaults (0-255 threshold, 0-64 feather)
DEFAULT_ALPHA_THRESHOLD=16
DEFAULT_ALPHA_FEATHER=0
DEFAULT_REMOVE_NEAR_TRANSPARENT=true
DEFAULT_ZERO_RGB_WHEN_TRANSPARENT=true
DEFAULT_PIXELS_PER_UNIT=100
DEFAULT_PIVOT_MODE=center

# --- Tileable seam inpainting (local Diffusers StableDiffusionInpaintPipeline) ---
# Uses circular offset + center-cross mask; no cloud APIs. Soft-blend is not a fallback.
SEAM_INPAINT_ENABLED=true
SEAM_INPAINT_MODEL_ID=runwayml/stable-diffusion-inpainting
SEAM_INPAINT_MODEL_REVISION=
SEAM_INPAINT_STEPS=20
DEFAULT_SEAM_WIDTH=64

# Logging
LOG_LEVEL=INFO
