# Copy to .env and adjust for your machine. Do not commit .env.

# Hugging Face model identifier (Diffusers-compatible text-to-image)
MODEL_ID=runwayml/stable-diffusion-v1-5
MODEL_REVISION=
MODEL_VARIANT=
MODEL_FAMILY=sd15
MODEL_DISPLAY_NAME=Stable Diffusion 1.5

# Device: auto | cuda | mps | cpu
DEVICE=auto

# Torch dtype: auto | float16 | bfloat16 | float32
TORCH_DTYPE=auto

# Where generated PNG + JSON metadata are written (relative or absolute)
OUTPUT_DIRECTORY=generated

# Authoritative generation policy (drives validation + capability reporting)
MIN_WIDTH=8
MAX_WIDTH=1024
MIN_HEIGHT=8
MAX_HEIGHT=1024
WIDTH_MULTIPLE=8
HEIGHT_MULTIPLE=8
MIN_STEPS=1
MAX_STEPS=150
DEFAULT_STEPS=25
MIN_GUIDANCE_SCALE=0.0
MAX_GUIDANCE_SCALE=30.0
DEFAULT_GUIDANCE_SCALE=7.0
MIN_SEED=0
MAX_SEED=4294967295
MAX_PROMPT_LENGTH=2000
MAX_NEGATIVE_PROMPT_LENGTH=2000
MAX_OUTPUT_NAME_LENGTH=100
MAX_CONCURRENT_GENERATIONS=1

# Stable public scheduler identifier when selection is unsupported
# DEFAULT_SCHEDULER=pndm

# Optional memory helpers for low-VRAM GPUs
ENABLE_CPU_OFFLOAD=false

# Set true to refuse downloading weights (offline / cached-only)
LOCAL_FILES_ONLY=false

# Optional: Hugging Face token if the model requires authentication
# HF_TOKEN=

# Logging
LOG_LEVEL=INFO
