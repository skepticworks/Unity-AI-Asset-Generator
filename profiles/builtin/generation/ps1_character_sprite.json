{
  "schema": {
    "name": "generation-profile",
    "version": "1.1"
  },
  "profile": {
    "id": "ps1_character_sprite",
    "revision": 1,
    "display_name": "PS1 Character Sprite",
    "description": "Single character sprite with PS1-inspired low-resolution appearance. Transparent backgrounds are produced via local background-removal post-processing, not native model alpha. Single-sprite import only (no sprite sheets).",
    "asset_type": "sprite",
    "builtin": true,
    "tags": ["ps1", "character", "sprite"]
  },
  "prompt": {
    "template_id": "ps1_character_sprite",
    "template_revision": 1,
    "default_modifiers": [
      "front-facing or three-quarter view",
      "readable proportions"
    ]
  },
  "negative_prompt": {
    "profile_id": "sprite_negative",
    "profile_revision": 1,
    "additional_terms": []
  },
  "generation_defaults": {
    "width": 512,
    "height": 512,
    "steps": 25,
    "guidance_scale": 7.0,
    "seed_strategy": "random",
    "fixed_seed": null,
    "transparency_strategy": "background_removal",
    "alpha_threshold": 16,
    "alpha_feather": 0,
    "remove_near_transparent": true,
    "zero_rgb_when_transparent": true,
    "pixels_per_unit": 100,
    "pivot_mode": "bottom_center",
    "custom_pivot_x": null,
    "custom_pivot_y": null,
    "atlas_hint": "characters"
  },
  "unity": {
    "import_profile_id": "ps1_sprite",
    "suggested_output_directory": "Assets/Generated/Sprites",
    "create_material": false,
    "pixels_per_unit": 100,
    "pivot_mode": "bottom_center",
    "custom_pivot_x": null,
    "custom_pivot_y": null,
    "atlas_hint": "characters"
  }
}
